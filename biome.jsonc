{
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "indentStyle": "space",
      "quoteStyle": "single",
      "arrowParentheses": "asNeeded",
      "lineWidth": 120
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space"
    }
  },
  "html": {
    "formatter": {
      "enabled": false,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineEnding": "lf",
      "attributePosition": "auto"
    }
  },
  "css": {
    "formatter": {
      "enabled": false,
      "quoteStyle": "single"
    },
    "parser": {
      "cssModules": true
    },
    "linter": {
      "enabled": true
    },
    "assist": {
      "enabled": false
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useBlockStatements": "error"
      }
    }
  }
}
