{
  "name": "nbs-converter",
  "module": "parse-nbs.ts",
  "type": "module",
  "scripts": {
    "build": "bun run build:windows && bun run build:linux && bun run build:mac",
    "build:windows": "bun build --compile --target bun-windows-x64 --outfile build/nbs-converter-windows-x64.exe index.ts",
    "build:linux": "bun build --compile --target bun-linux-x64 --outfile build/nbs-converter-linux-x64 index.ts",
    "build:mac": "bun build --compile --target bun-darwin-x64 --outfile build/nbs-converter-darwin-x64 index.ts",
    "build:web": "bun build --target browser --outdir web --entry-naming main.js web/main.ts",
    "verify": "bun run verify.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/bun": "^1.2.20",
    "@types/command-line-args": "^5.2.3"
  },
  "peerDependencies": {
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@nbsjs/core": "^6.0.0",
    "@ungap/compression-stream": "^0.2.0",
    "command-line-args": "^6.0.1",
    "nbtify": "^2.2.0"
  }
}
